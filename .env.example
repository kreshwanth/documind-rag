# DocuMind Environment Configuration

# Database Settings
POSTGRES_USER=documind_user
POSTGRES_PASSWORD=documind_secure_password
POSTGRES_DB=documind_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://documind_user:documind_secure_password@postgres:5432/documind_db

# Security & JWT
JWT_SECRET=documind_super_secret_jwt_key_change_in_production_987234982374
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-1.5-flash
EMBEDDING_DIMENSION=768

# RAG Retrieval Configuration
TOP_K=4
SIMILARITY_THRESHOLD=0.40

# Storage & Ingestion
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Environment & CORS
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
